# Better Call Wes booking-api — environment template
# Copy to .env (locally) or set in Coolify's env panel (production).

# REQUIRED: ServiceM8 API key (X-Api-Key auth)
SERVICEM8_API_KEY=

# OPTIONAL: comma-separated CORS allowed origins
# Defaults to: https://bettercallwes.co.uk,https://www.bettercallwes.co.uk,http://localhost:8000
ALLOWED_ORIGINS=https://bettercallwes.co.uk,https://www.bettercallwes.co.uk

# OPTIONAL: path to services.json. Defaults to ../site/data/services.json
# (relative to the booking-api dir). In Docker it's baked to /app/services.json.
# SERVICES_JSON=/app/services.json

# OPTIONAL: how many days ahead to expose availability (default 14)
DEFAULT_DAYS_AHEAD=14

# OPTIONAL: cache TTLs (seconds)
MATERIALS_CACHE_TTL=300
ACTIVITY_CACHE_TTL=60

# OPTIONAL: log level (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# OPTIONAL: port (Coolify usually injects this automatically)
PORT=8000

# Dev-only: set to 1 to enable uvicorn auto-reload
# DEV=1
