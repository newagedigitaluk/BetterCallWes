{
  "$schema": "https://bettercallwes.co.uk/data/services.schema.json",
  "$comment": "Source of truth for the booking form's service/question/material wiring. Prices are NOT stored here — they're fetched live from ServiceM8's material API by item_number at form load (see /api/materials). UUIDs are stable references into ServiceM8 (job templates + categories). The form maps user answers to materials by item_number; the backend resolves item_number → uuid + live price when creating jobmaterial rows.",
  "config": {
    "working_hours": {
      "days": [
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri"
      ],
      "morning_start": "09:00",
      "morning_end": "12:00",
      "afternoon_start": "13:00",
      "afternoon_end": "17:00",
      "lunch_break": "12:00-13:00",
      "timezone": "Europe/London"
    },
    "booking_rules": {
      "min_lead_time_hours": 2,
      "same_day_cutoff_hour": 15,
      "latest_start_time": "16:30",
      "whole_day_min_lead_days": 1
    },
    "service_area": {
      "postcodes": [
        "SO14",
        "SO15",
        "SO16",
        "SO17",
        "SO18",
        "SO19",
        "SO30",
        "SO31",
        "SO40",
        "SO45",
        "SO50",
        "SO51",
        "SO53"
      ],
      "rejection_message": "I cover Southampton postcodes SO14 to SO53. Your postcode is outside my regular area, but message me on WhatsApp and I'll let you know if I can help."
    },
    "labour_hour_rate": {
      "item_number": "LAB-HOUR-001",
      "price_hint_per_hour": 100
    },
    "staff_uuid": "5673d021-27b2-4356-a14b-1760cabfcd3b"
  },
  "services": {
    "boiler-service": {
      "name": "Boiler Service",
      "short_description": "Annual boiler safety inspection and clean. Standard or full stripdown.",
      "template_uuid": "7787800d-2640-42b4-b43f-242e0ac3513d",
      "category_uuid": "506bcb7e-579c-42cf-aef2-1bd946440eeb",
      "base_material_item": "LAB-BOIL-STAN",
      "base_duration_min": 60,
      "questions": [
        {
          "id": "service-level",
          "label": "Which level of service?",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "standard",
              "label": "Standard Boiler Service",
              "duration_min": 60,
              "material_swap": null
            },
            {
              "value": "full-stripdown",
              "label": "Full Stripdown Service",
              "duration_min": 120,
              "material_swap": "LAB-BOIL-FULL-SERV"
            }
          ]
        },
        {
          "id": "add-cylinder-service",
          "label": "Add unvented cylinder service?",
          "type": "checkbox",
          "material_add": "LAB-US-CYL-SERV"
        },
        {
          "id": "add-water-test",
          "label": "Add a central heating water test?",
          "type": "checkbox",
          "material_add": "SYS-WAT-TEST"
        },
        {
          "id": "add-inhibitor",
          "label": "Top up central heating inhibitor?",
          "type": "checkbox",
          "material_add": "LAB-US-TOPUP"
        },
        {
          "id": "add-co-alarm",
          "label": "Supply and install a carbon monoxide alarm?",
          "type": "checkbox",
          "material_add": "LAB-US-COALARM"
        },
        {
          "id": "add-gas-safety",
          "label": "Add a Gas Safety Check certificate (CP12)?",
          "type": "checkbox",
          "material_add": "LAB-US-GSC",
          "category_swap_when_checked": "04362e23-b01b-4b3b-883c-1bdde302fceb",
          "duration_add_min": 30
        }
      ]
    },
    "gas-safety-check": {
      "name": "Gas Safety Check (CP12)",
      "short_description": "Annual landlord or homeowner safety check. Certificate issued same day.",
      "template_uuid": "460639d5-f5bc-43d8-9c2c-242e00d6f76d",
      "category_uuid": "40777738-5689-4138-b470-1bd946fec30b",
      "base_material_item": "LAB-SERV-GSC",
      "base_duration_min": 60,
      "base_covers": "1 boiler + 1 hob",
      "questions": [
        {
          "id": "appliances",
          "label": "What gas appliances need checking?",
          "subtext": "Boiler and hob are included in the base price. Gas fires are charged extra per fire.",
          "type": "checkbox-multi",
          "required": true,
          "options": [
            {
              "value": "boiler",
              "label": "Boiler"
            },
            {
              "value": "hob",
              "label": "Gas hob / cooker"
            },
            {
              "value": "fire",
              "label": "Gas fire (charged per fire)"
            },
            {
              "value": "other",
              "label": "Other gas appliance"
            }
          ]
        },
        {
          "id": "fire-count",
          "label": "How many gas fires?",
          "type": "number",
          "min": 1,
          "max": 10,
          "default": 1,
          "show_if": {
            "question": "appliances",
            "includes": "fire"
          },
          "material_add": "LAB-GSC-GF",
          "material_quantity_from": "value",
          "duration_add_min_per_unit": 20
        },
        {
          "id": "add-boiler-service",
          "label": "Add a boiler service at the same time?",
          "subtext": "Combined discount applies.",
          "type": "checkbox",
          "material_add": "LAB-US-BS",
          "category_swap_when_checked": "04362e23-b01b-4b3b-883c-1bdde302fceb",
          "duration_add_min": 45,
          "reveals_question_group": "boiler-details"
        },
        {
          "id": "property-type",
          "label": "What's this check for?",
          "type": "radio",
          "options": [
            {
              "value": "landlord",
              "label": "Rental property (landlord certificate)"
            },
            {
              "value": "homeowner",
              "label": "My own home"
            },
            {
              "value": "sale",
              "label": "Property sale / mortgage"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "optional": true
        }
      ]
    },
    "boiler-repair": {
      "name": "Boiler Repair / Diagnostic",
      "short_description": "£100 first-hour diagnostic. Larger repairs quoted on site, with the diagnostic fee deducted.",
      "template_uuid": "4da56ffe-6e9c-44fd-83b3-242e06f6d0cd",
      "category_uuid": "f37b712c-ab9f-401f-8e93-1bd8be857b1b",
      "base_material_item": "LAB-CALLOUT",
      "base_duration_min": 60,
      "fixed_price": true,
      "questions": [
        {
          "id": "main-issue",
          "label": "What's the main problem?",
          "type": "checkbox-multi",
          "required": true,
          "options": [
            {
              "value": "no-heat",
              "label": "No heating"
            },
            {
              "value": "no-hot-water",
              "label": "No hot water"
            },
            {
              "value": "low-pressure",
              "label": "Boiler keeps losing pressure"
            },
            {
              "value": "noisy",
              "label": "Banging, kettling, or whistling noises"
            },
            {
              "value": "leaking",
              "label": "Visible leak from the boiler"
            },
            {
              "value": "error-code",
              "label": "Showing an error code"
            },
            {
              "value": "pilot-out",
              "label": "Pilot light keeps going out"
            },
            {
              "value": "wont-fire",
              "label": "Won't fire up / no response"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "id": "error-code",
          "label": "What error code is showing?",
          "type": "text",
          "show_if": {
            "question": "main-issue",
            "includes": "error-code"
          },
          "placeholder": "e.g. F22, EA, F75",
          "optional": true
        },
        {
          "id": "urgency",
          "label": "How urgent is this?",
          "type": "radio",
          "options": [
            {
              "value": "today",
              "label": "Today if possible (no heat / hot water)"
            },
            {
              "value": "this-week",
              "label": "This week"
            },
            {
              "value": "next-week",
              "label": "Next week is fine"
            }
          ]
        },
        {
          "id": "photos",
          "label": "Photo of the boiler / error code (optional)",
          "type": "file",
          "accept": "image/*",
          "multiple": true,
          "optional": true
        }
      ]
    },
    "power-flush": {
      "name": "Power Flush",
      "short_description": "Deep clean of your heating system to remove sludge. Base price covers up to 8 radiators.",
      "template_uuid": "7fa5cb6d-e5b3-495b-9c5d-242e078d6efd",
      "category_uuid": "daaf3c85-bbf1-4121-99f7-1bd9490e001b",
      "base_material_item": "LAB-FLSH-PF",
      "base_duration_min": 480,
      "base_covers": "Up to 8 radiators",
      "always_add_materials": [
        "HTADMC5",
        "HTADMC1"
      ],
      "questions": [
        {
          "id": "system-type",
          "label": "What type of heating system?",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "sealed",
              "label": "Sealed / pressurised system"
            },
            {
              "value": "open-vent",
              "label": "Open vent with header tank in loft",
              "material_add": "LAB-FLSH-PF-OV"
            },
            {
              "value": "unsure",
              "label": "Not sure"
            }
          ]
        },
        {
          "id": "rad-count",
          "label": "How many radiators are on the system?",
          "type": "number",
          "min": 1,
          "max": 20,
          "default": 8,
          "subtext": "Up to 8 radiators included in the base price; each extra radiator is charged via the per-radiator add-on.",
          "material_add_when_over": {
            "threshold": 8,
            "material": "LAB-FLSH-RAD",
            "quantity_from": "value_minus_threshold"
          }
        },
        {
          "id": "magnetic-filter",
          "label": "Supply and fit a magnetic filter (Adey MagnaClean Pro 2)?",
          "subtext": "Recommended for every system; manufacturer warranty often requires one.",
          "type": "checkbox",
          "material_add": "LAB-SUPP-FILT-PRO2"
        }
      ]
    },
