website/Brand Images/

# Generated ad creatives (images) — outputs of social/generate_ads*.py.
# Keep the JSON logs + small scripts in ads/; just exclude the heavy media.
website/social/ads/**/*.jpg
website/social/ads/**/*.jpeg
website/social/ads/**/*.png
website/social/ads/**/*.webp

# Heavy invoice templates (>10MB, embedded images). Lighter variants stay tracked.
website/ServiceM8/BCW - Invoice Modern.docx
website/ServiceM8/BCW - Invoice Premium.docx

